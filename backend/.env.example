PORT=3000
NODE_ENV=production
# PostgreSQL connection string from your managed database provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
# Generate a long random secret (at least 32 bytes); keep only in hosting secrets
JWT_SECRET=replace_with_long_random_secret
# OpenAI official API settings; choose a model enabled for your API project
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_me_server_side_only
AI_MODEL=replace_with_model_available_in_your_openai_project
AI_TIMEOUT_MS=60000
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=
